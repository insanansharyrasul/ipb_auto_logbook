import QtQuick.tooling 1.2

Module {
    Component {
        name: "AppController"
        prototype: "QObject"
        exports: ["App/Controller 1.0"]
        isSingleton: true

        Property { name: "username"; type: "QString"; notify: "usernameChanged" }
        Property { name: "password"; type: "QString"; notify: "passwordChanged" }
        Property { name: "dosen"; type: "QString"; notify: "dosenChanged" }
        Property { name: "rowNumber"; type: "QString"; notify: "rowNumberChanged" }
        Property { name: "semester"; type: "QString"; notify: "semesterChanged" }
        Property { name: "csvPath"; type: "QString"; notify: "csvPathChanged" }
        Property { name: "headless"; type: "bool"; notify: "headlessChanged" }
        Property { name: "slowMo"; type: "int"; notify: "slowMoChanged" }
        Property { name: "running"; type: "bool"; notify: "runningChanged"; read: "running" }
        Property { name: "stopping"; type: "bool"; notify: "stoppingChanged"; read: "stopping" }
        Property { name: "statusText"; type: "QString"; notify: "statusTextChanged"; read: "statusText" }
        Property { name: "statusKind"; type: "QString"; notify: "statusKindChanged"; read: "statusKind" }
        Property { name: "progressCurrent"; type: "int"; notify: "progressChanged"; read: "progressCurrent" }
        Property { name: "progressTotal"; type: "int"; notify: "progressChanged"; read: "progressTotal" }
        Property { name: "logText"; type: "QString"; notify: "logTextChanged"; read: "logText" }
        Property { name: "tipeValues"; type: "QVariantList"; read: "tipeValues" }
        Property { name: "beritaValues"; type: "QVariantList"; read: "beritaValues" }
        Property { name: "maintainers"; type: "QVariantList"; read: "maintainers" }
        Property { name: "donators"; type: "QVariantList"; read: "donators" }
        Property { name: "appVersion"; type: "QString"; read: "appVersion" }
        Property { name: "dosenInfo"; type: "QString"; read: "dosenInfo" }
        Property { name: "rowNumberInfo"; type: "QString"; read: "rowNumberInfo" }
        Property { name: "semesterInfo"; type: "QString"; read: "semesterInfo" }

        Signal { name: "usernameChanged" }
        Signal { name: "passwordChanged" }
        Signal { name: "dosenChanged" }
        Signal { name: "rowNumberChanged" }
        Signal { name: "semesterChanged" }
        Signal { name: "csvPathChanged" }
        Signal { name: "headlessChanged" }
        Signal { name: "slowMoChanged" }
        Signal { name: "runningChanged" }
        Signal { name: "stoppingChanged" }
        Signal { name: "statusTextChanged" }
        Signal { name: "statusKindChanged" }
        Signal { name: "progressChanged" }
        Signal { name: "logTextChanged" }

        Method { name: "chooseCsvFile" }
        Method { name: "chooseSaveConfig" }
        Method { name: "chooseLoadConfig" }
        Method { name: "chooseLoadCsv" }
        Method { name: "chooseSaveCsv" }
        Method { name: "chooseRowFile"; Parameter { name: "row"; type: "int" } }
        Method { name: "loadCsv" }
        Method { name: "start" }
        Method { name: "stop" }
        Method { name: "shutdown" }
    }
}